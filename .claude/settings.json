{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -B tools/sync_pcs.py start",
            "timeout": 60,
            "statusMessage": "Sincronizando com o GitHub..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "python -B tools/sync_pcs.py push",
            "timeout": 60,
            "statusMessage": "Enviando o commit ao GitHub..."
          },
          {
            "type": "command",
            "if": "PowerShell(git commit*)",
            "command": "python -B tools/sync_pcs.py push",
            "timeout": 60,
            "statusMessage": "Enviando o commit ao GitHub..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -B tools/sync_pcs.py check",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
